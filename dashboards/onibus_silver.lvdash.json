{
 "datasets": [
  {
   "name": "a9d8acdd",
   "displayName": "velocidade_hora",
   "queryLines": [
    "SELECT hour(janela_sp) AS hora_sp, tipo_dia,\r\n",
    "       round(sum(dist_m) / sum(tempo_s) * 3.6, 1) AS v_kmh\r\n",
    "FROM onibus.silver.velocidade_trecho\r\n",
    "GROUP BY 1, 2"
   ]
  },
  {
   "name": "2482c88f",
   "displayName": "dia_velocidade_chuva",
   "queryLines": [
    "WITH v AS (SELECT dt, first(tipo_dia) AS tipo_dia,\r\n",
    "                  round(sum(dist_m) / sum(tempo_s) * 3.6, 2) AS v_kmh\r\n",
    "           FROM onibus.silver.velocidade_trecho\r\n",
    "           WHERE hour(janela_sp) BETWEEN 6 AND 21 GROUP BY dt),\r\n",
    "     c AS (SELECT dt, round(percentile_approx(mm_dia, 0.5), 1) AS chuva_mm\r\n",
    "           FROM (SELECT c.dt, c.prefixo, sum(c.mm) AS mm_dia\r\n",
    "                 FROM onibus.silver.chuva_10min c JOIN onibus.silver.postos p USING (prefixo)\r\n",
    "                 WHERE p.status = 'ok' AND p.duplicata_de IS NULL GROUP BY 1, 2)\r\n",
    "           GROUP BY dt)\r\n",
    "SELECT to_date(v.dt) AS dia, v.tipo_dia, v.v_kmh, c.chuva_mm\r\n",
    "FROM v LEFT JOIN c USING (dt)"
   ]
  },
  {
   "name": "fada5d7b",
   "displayName": "mapa_trechos_pico",
   "queryLines": [
    "SELECT v.parada_de, s.stop_name, s.stop_lat, s.stop_lon,\r\n",
    "       round(sum(v.dist_m) / sum(v.tempo_s) * 3.6, 1) AS v_kmh, sum(v.n_pares) AS n_pares\r\n",
    "FROM onibus.silver.velocidade_trecho v\r\n",
    "JOIN onibus.silver.gtfs_stops s\r\n",
    "  ON CAST(s.stop_id AS STRING) = v.parada_de AND s.versao = v.versao_gtfs\r\n",
    "WHERE v.tipo_dia = 'util' AND hour(v.janela_sp) BETWEEN 17 AND 18\r\n",
    "GROUP BY 1, 2, 3, 4\r\n",
    "HAVING sum(v.n_pares) >= 200"
   ]
  },
  {
   "name": "d22c63b7",
   "displayName": "postos",
   "queryLines": [
    "SELECT prefixo, nome, rede, status, lat, lon, mm_total, completude\r\n",
    "FROM onibus.silver.postos"
   ]
  },
  {
   "name": "kpis0001",
   "displayName": "kpis",
   "queryLines": [
    "SELECT\n",
    "  (SELECT count(DISTINCT dt) FROM onibus.silver.velocidade_trecho) AS dias,\n",
    "  (SELECT round(count(*) / 1e6, 0) FROM onibus.silver.posicao_limpa) AS posicoes_milhoes,\n",
    "  (SELECT count(DISTINCT parada_de, parada_ate) FROM onibus.silver.velocidade_trecho) AS trechos_fisicos,\n",
    "  (SELECT count(*) FROM onibus.silver.postos WHERE status = 'ok' AND duplicata_de IS NULL) AS postos_chuva\n"
   ]
  },
  {
   "name": "mapafx01",
   "displayName": "mapa_trechos_pico_faixas",
   "queryLines": [
    "SELECT v.parada_de, s.stop_name, s.stop_lat, s.stop_lon,\n",
    "       round(sum(v.dist_m) / sum(v.tempo_s) * 3.6, 1) AS v_kmh,\n",
    "       CASE WHEN sum(v.dist_m) / sum(v.tempo_s) * 3.6 < 10 THEN '1. menos de 10 km/h'\n",
    "            WHEN sum(v.dist_m) / sum(v.tempo_s) * 3.6 < 15 THEN '2. 10 a 15 km/h'\n",
    "            WHEN sum(v.dist_m) / sum(v.tempo_s) * 3.6 < 20 THEN '3. 15 a 20 km/h'\n",
    "            ELSE '4. mais de 20 km/h' END AS faixa\n",
    "FROM onibus.silver.velocidade_trecho v\n",
    "JOIN onibus.silver.gtfs_stops s\n",
    "  ON CAST(s.stop_id AS STRING) = v.parada_de AND s.versao = v.versao_gtfs\n",
    "WHERE v.tipo_dia = 'util' AND hour(v.janela_sp) BETWEEN 17 AND 18\n",
    "GROUP BY 1, 2, 3, 4\n",
    "HAVING sum(v.n_pares) >= 200\n"
   ]
  }
 ],
